---
// One surface. The practice nav went when the business pages came down.
const path = Astro.url.pathname;

const links = [
  { href: '/', label: 'home' },
  { href: '/work', label: 'work' },
  { href: '/research/claims-capacity-collateral', label: 'research' },
  { href: '/writing', label: 'writing' },
  { href: '/about', label: 'about' },
  { href: '/contact', label: 'contact', accent: true },
];

const isActive = (href: string) => {
  const base = href.split('#')[0];
  return path === base || (base !== '/' && path.startsWith(base));
};
---

<nav aria-label="Main navigation">
  <ul>
    {links.map(link => (
      <li>
        <a
          href={link.href}
          class:list={[{ active: isActive(link.href) }, { 'nav-accent': link.accent }]}
          aria-current={isActive(link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  nav { padding: 0.85rem 0 0.35rem; margin-bottom: 0.5rem; }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.1rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  a {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--white-60);
    text-decoration: none;
    text-transform: lowercase;
    border-bottom: none;
    transition: color 0.2s;
  }

  a:hover, a.active { color: var(--glow-hot); }

  .nav-accent { color: var(--gold-accent); }
  .nav-accent:hover, .nav-accent.active { color: var(--glow-hot); }

  @media (max-width: 480px) {
    ul { gap: 0.5rem 0.8rem; }
    a { font-size: 0.72rem; }
  }

</style>
