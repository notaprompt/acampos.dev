---
// Two surfaces, two navs, chosen by path.
//
// This site carries a person and a business. One nav for both meant every
// visitor saw a consulting menu next to the writing, and a hiring manager
// met the storefront before the work. Now the main site shows four items and
// the practice shows its own four; each surface links to the other exactly
// once, elsewhere on the page, so the nav never has to do that job.
const path = Astro.url.pathname;
const practice = /^\/(services|snapshot|ai-visibility|the-index)(\/|$)/.test(path);

const links = practice
  ? [
      { href: '/services', label: 'the practice' },
      { href: '/services#parts', label: 'systems' },
      { href: '/services/pricing', label: 'pricing' },
      { href: '/contact', label: 'contact' },
      { href: '/snapshot', label: 'free snapshot', accent: true },
    ]
  : [
      { href: '/', label: 'home' },
      { href: '/work', label: 'work' },
      { href: '/writing', label: 'writing' },
      { href: '/about', label: 'about' },
      { href: '/contact', label: 'contact', accent: true },
    ];

const isActive = (href: string) => {
  const base = href.split('#')[0];
  return path === base || (base !== '/' && path.startsWith(base) && !(base === '/services' && path.startsWith('/services/pricing') && href !== '/services/pricing'));
};
---

<nav aria-label="Main navigation" class:list={[{ practice }]}>
  <ul>
    {links.map(link => (
      <li>
        <a
          href={link.href}
          class:list={[{ active: isActive(link.href) }, { 'nav-accent': link.accent }]}
        >
          {link.label}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  nav {
    border-top: 2px dashed var(--white-08);
    border-bottom: 2px dashed var(--white-08);
    padding: 0.6rem 0;
    margin-bottom: 0.5rem;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  a {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--white-45);
    text-decoration: none;
    text-transform: lowercase;
    border-bottom: none;
    transition: color 0.2s;
  }

  a:hover, a.active { color: var(--glow-hot); }

  .nav-accent { color: var(--gold-accent); }
  .nav-accent:hover, .nav-accent.active { color: var(--glow-hot); }

  /* The practice runs its own accent so the surface reads as its own property. */
  nav.practice .nav-accent { color: #7aa498; }
</style>
