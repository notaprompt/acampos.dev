---
import Page from '../layouts/Page.astro';

const links = [
  { label: 'GitHub', url: 'https://github.com/notaprompt', desc: 'Source code and experiments' },
  { label: 'Reframed', url: 'https://reframed.works', desc: 'The resume product' },
  { label: 'Substack', url: 'https://substack.com/@alexinthefield', desc: 'Writing elsewhere' },
  { label: 'LinkedIn', url: 'https://www.linkedin.com/in/alexander-d-campos/', desc: 'Professional background' },
  { label: 'X', url: 'https://x.com/flapfinned', desc: '@flapfinned' },
];
---

<Page title="links -- alexander campos" description="Where to find my code, writing, and other work.">
  <article>
    <h1>Elsewhere</h1>
    <p>My code, writing, and other work around the web.</p>
    <ul class="links">
      {links.map(link => (
        <li>
          <a href={link.url} target="_blank" rel="noopener noreferrer">{link.label}</a>
          <span>{link.desc}</span>
        </li>
      ))}
    </ul>
    <h2>Influences</h2>
    <p><a href="/influences">People and music I return to</a>, with a few notes on what I take from their work.</p>
  </article>
</Page>

<style>
  .links { list-style: none; padding: 0; margin: 2rem 0 3rem; }
  .links li { display: grid; grid-template-columns: 7rem 1fr; gap: 1rem; margin-bottom: 1rem; }
  .links span { color: var(--white-60); }
  @media (max-width: 480px) {
    .links li { grid-template-columns: 5.5rem 1fr; gap: 0.5rem; }
  }
</style>
