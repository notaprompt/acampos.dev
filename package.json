{
  "name": "campos-site",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "node --experimental-strip-types --no-warnings --import ./scripts/register-ts.mjs --test tests/*.test.ts",
    "test:watch": "node --experimental-strip-types --no-warnings --import ./scripts/register-ts.mjs --test --watch tests/*.test.ts",
    "typecheck": "tsc --noEmit --skipLibCheck --module nodenext --target es2022 --moduleResolution nodenext --strict api/_lib/*.ts api/snapshot/*.ts api/leads/*.ts api/admin/*.ts api/agent/*.ts api/audit/*.ts api/*.ts",
    "bulk": "node --experimental-strip-types --no-warnings scripts/bulk-snapshot.mjs",
    "verify": "npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.88.0",
    "@astrojs/mdx": "^4.3.14",
    "@astrojs/sitemap": "^3.7.0",
    "@neondatabase/serverless": "^1.0.2",
    "@vercel/node": "^5.6.18",
    "astro": "^5.17.1",
    "tone": "^15.1.22"
  }
}
