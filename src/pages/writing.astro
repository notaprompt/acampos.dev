---
import { getCollection } from 'astro:content';
import Page from '../layouts/Page.astro';

const essays = (await getCollection('essays', ({ data }) => data.status === 'published'))
  .sort((a, b) => b.data.date.localeCompare(a.data.date));

const formatDate = (date: string) => new Date(`${date}T00:00:00Z`).toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<Page title="writing -- alexander campos" description="Essays from building software: memory, interpretation, incentives, and the distance between understanding a problem and changing it.">
  <article class="writing">
    <header class="writing-header">
      <h1>Writing</h1>
      <p class="lede">
        Building gives me something to argue with. These essays follow the questions
        that stayed with me after the code ran: what a tool learns about a person,
        what it gets wrong, and whether the work is helping anyone move.
      </p>
    </header>

    <div class="writing-list">
      {essays.map(essay => (
        <section class="writing-entry" aria-labelledby={`essay-${essay.slug}`}>
          <h2 id={`essay-${essay.slug}`}><a href={`/writing/${essay.slug}`}>{essay.data.title}</a></h2>
          <p class="date"><time datetime={essay.data.date}>{formatDate(essay.data.date)}</time></p>
          <p>{essay.data.subtitle}</p>
        </section>
      ))}
    </div>
  </article>
</Page>

<style>
  .writing {
    max-width: 100%;
  }

  .writing-header {
    margin-bottom: 3.5rem;
  }

  .lede {
    font-size: 1.16rem;
    line-height: 1.7;
  }

  .writing-entry {
    margin-bottom: 2.75rem;
  }

  .writing-entry h2 {
    font-size: 1.5rem;
    line-height: 1.3;
    margin: 0 0 0.4rem;
  }

  .writing-entry h2 a {
    color: var(--glow-hot);
    border: 0;
  }

  .writing-entry h2 a:hover {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .date {
    font-family: var(--body);
    font-size: 0.9rem;
    margin-bottom: 0.65rem;
  }

  .writing-entry p:last-child {
    font-size: 1.06rem;
    line-height: 1.7;
    margin-bottom: 0;
  }
</style>
