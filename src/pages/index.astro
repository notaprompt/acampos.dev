---
import Page from '../layouts/Page.astro';
import HitCounter from '../components/HitCounter.astro';
import { getCollection } from 'astro:content';
import office from '../data/office.json';

// The cards read from the same collections the project pages do - the
// homepage can no longer drift from the truth it links to.
const projects = (await getCollection('projects'))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
const essays = (await getCollection('essays'))
  .filter((e) => e.data.status === 'published')
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .slice(0, 3);
const officeLine = [
  office.memories && `${office.memories.toLocaleString('en-US')} memories on this desk`,
  office.forecasts && `${office.forecasts.toLocaleString('en-US')} signed forecasts`,
  office.services && `${office.services} services under launchd`,
].filter(Boolean).join(' · ');
---

<Page title="alexander campos" description="Alexander Campos - engineer who builds and ships agent memory, model routing, and the tools that make them usable. Reframed (live), ForgeFrame (open source).">
  <section class="splash">
    <h1 class="site-name">Alexander Campos</h1>
    <p class="lede">I build tools for you, your agents, and your business — memory, automations, and the operations underneath.</p>
    <p class="tagline">Operator by trade, builder by habit. Six years running operations in regulated finance, where a missed handoff is an audit finding rather than an inconvenience. Three products live. I build the whole stack myself, mostly at night. It's most of what I think about, and sometimes I <a href="/writing">write it down</a>.</p>
    <p class="warm-line">you are at the front door.</p>

    <div class="retro-marquee-wrap" aria-hidden="true">
      <span class="retro-marquee-text">
        <a href="https://reframed.works" style="color: var(--gold-accent); text-decoration: none; border-bottom: none;">reframed.works — live</a>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;playing like it pays · building like it's clay — NoVA&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<a href="https://reframed.works" style="color: var(--gold-accent); text-decoration: none; border-bottom: none;">reframed.works — live</a>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;playing like it pays · building like it's clay — NoVA&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
      </span>
    </div>
  </section>

  <!-- the one thing to do here -->
  <section class="home-section">
    <a class="home-offer" href="/snapshot">
      <span class="offer-eyebrow">start here · free · about a minute</span>
      <span class="offer-head">See where your business actually stands</span>
      <span class="offer-body">
        Give me your website. I read it the way a customer would, check what the rest
        of the internet says about you, and show you the leaks with real numbers on them.
        No login. If you're in good shape, it says so.
      </span>
      <span class="offer-go">run my snapshot <span aria-hidden="true">→</span></span>
    </a>
    <p class="offer-alt">
      Or see <a href="/services">what I build and what it costs</a>.
      <span class="alt-sep" aria-hidden="true">·</span>
      Here to read rather than hire? <a href="/work">the work</a> and
      <a href="/writing">the writing</a>.
    </p>
  </section>

  <!-- proof -->
  <section class="home-section">
    <h2 class="section-heading">what I build</h2>

    <div class="project-cards">
      {projects.map((p) => (
        <a href={`/projects/${p.slug}`} class="project-card">
          <span class="project-name">{p.data.title}</span>
          <span class="project-line">
            {p.data.tagline}
            {p.data.demo && <> Live at <span class="gold">{new URL(p.data.demo).hostname}</span>.</>}
          </span>
        </a>
      ))}
    </div>

    <p class="more-link"><a href="/projects">all projects >></a></p>
  </section>

  <!-- what I think -->
  <section class="home-section">
    <h2 class="section-heading">what I think</h2>

    <div class="essay-cards">
      {essays.map((e) => (
        <a href={`/writing/${e.slug}`} class="essay-card">
          <span class="essay-title">{e.data.title}</span>
          <span class="essay-line">{e.data.subtitle}</span>
        </a>
      ))}
    </div>

    <p class="more-link"><a href="/writing">all writing >></a></p>
  </section>

  <!-- the short version -->
  <section class="home-section">
    <h2 class="section-heading">the short version</h2>
    <p class="home-prose dim">
      Business degree, six years in regulated fintech and banking operations, and I build
      the whole stack myself. The <a href="/resume">resume</a> has the history; the
      <a href="https://github.com/notaprompt">repos</a> have the code.
    </p>

    {officeLine && <p class="office-line">{officeLine} - as of {office.asof}</p>}

    <div class="counter-row">
      <HitCounter />
    </div>
  </section>

  <script is:inline>
    console.log(
      '%c you are at the front door -- again, kinda. ',
      'color: #b8965a; font-family: monospace; font-size: 11px;'
    );
  </script>

  <script is:inline src="/islands/hit-counter.js"></script>
</Page>

<style>
  /* A link inside the tagline should read as a word, not a call to action. */
  .tagline a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid var(--white-20);
    transition: border-color 0.18s ease, color 0.18s ease;
  }
  .tagline a:hover { color: var(--gold-accent); border-bottom-color: var(--gold-accent); }

  /* ── The one action ──
     A single bordered block instead of a row of pills. One decision, made
     obvious, with the reason to press it sitting inside it rather than three
     paragraphs above it. */
  .home-offer {
    display: block;
    border: 1px solid var(--white-15);
    padding: 1.5rem 1.6rem;
    text-decoration: none;
    transition: border-color 0.22s ease, background 0.22s ease;
  }
  .home-offer:hover { border-color: var(--gold-accent); background: var(--depth-1); }
  .home-offer:hover .offer-go { color: var(--gold-accent); }
  .home-offer:hover .offer-go span { transform: translateX(4px); }

  .offer-eyebrow {
    display: block;
    font-family: var(--mono);
    font-size: 0.63rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold-accent);
    margin-bottom: 0.7rem;
  }
  .offer-head {
    display: block;
    font-family: var(--serif);
    font-size: clamp(1.25rem, 3.4vw, 1.6rem);
    line-height: 1.22;
    color: var(--glow-hot);
    margin-bottom: 0.65rem;
    text-wrap: balance;
  }
  .offer-body {
    display: block;
    font-size: 0.92rem;
    color: var(--white-60);
    line-height: 1.65;
    max-width: 56ch;
    margin-bottom: 1rem;
  }
  .offer-go {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--white-45);
    transition: color 0.2s ease;
  }
  .offer-go span { transition: transform 0.2s ease; }

  .offer-alt {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--white-30);
    margin-top: 0.85rem;
  }
  .offer-alt a { color: var(--gold-accent); }
  .offer-alt .alt-sep { color: var(--white-15); margin: 0 0.45rem; }

  @media (prefers-reduced-motion: reduce) {
    .home-offer, .offer-go, .offer-go span { transition: none; }
  }

  /* ── Opening ── */
  .splash {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-bottom: 1rem;
  }

  .site-name {
    font-family: var(--serif);
    font-size: 1.6rem;
    font-weight: 600;
    color: var(--glow);
    margin: 0 0 0.75rem;
    letter-spacing: 0.02em;
  }

  .lede {
    font-family: var(--body);
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--glow);
    line-height: 1.6;
    margin: 0 0 0.9rem;
  }

  .tagline {
    font-family: var(--body);
    font-size: 0.95rem;
    color: var(--white-60, var(--glow));
    line-height: 1.7;
    margin-bottom: 0.75rem;
    opacity: 0.82;
  }

  .warm-line {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--white-30);
    margin-bottom: 2.5rem;
    letter-spacing: 0.01em;
  }

  /* ── Sections ── */
  .home-section {
    padding: 1.75rem 0 0.5rem;
    border-top: 1px solid var(--white-04);
  }

  .section-heading {
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--white-20);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0 0 1rem;
  }

  .home-prose {
    font-family: var(--body);
    font-size: 0.9rem;
    color: var(--white-60);
    line-height: 1.65;
    max-width: 540px;
  }

  .home-prose.dim { color: var(--white-30); font-family: var(--mono); font-size: 0.75rem; }

  .home-prose a {
    color: var(--white-70);
    border-bottom: 1px dashed var(--white-20);
  }

  .home-prose a:hover {
    color: var(--gold-accent);
    border-bottom-color: var(--gold-accent);
  }

  .more-link {
    margin-top: 0.75rem;
  }

  .more-link a {
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--gold-accent);
    border-bottom: none;
  }

  .more-link a:hover { color: var(--glow-hot); }

  /* ── Project cards ── */
  .project-cards {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .project-card {
    display: block;
    border: 1px solid var(--white-08);
    padding: 0.85rem 1rem;
    text-decoration: none;
    transition: border-color 0.2s;
  }

  .project-card:hover { border-color: var(--gold-accent); }

  .project-name {
    font-family: var(--mono);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--glow);
    display: block;
    margin-bottom: 0.25rem;
  }

  .project-line {
    font-family: var(--body);
    font-size: 0.8rem;
    color: var(--white-45);
    line-height: 1.5;
  }

  .gold { color: var(--gold-accent); }

  /* ── Essay cards ── */
  .essay-cards {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .essay-card {
    display: block;
    border: 1px solid var(--white-08);
    padding: 0.65rem 1rem;
    text-decoration: none;
    transition: border-color 0.2s;
  }

  .essay-card:hover { border-color: var(--gold-accent); }

  .essay-title {
    font-family: var(--serif);
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--glow);
    display: block;
    margin-bottom: 0.2rem;
  }

  .essay-line {
    font-family: var(--body);
    font-size: 0.75rem;
    color: var(--white-45);
    line-height: 1.5;
  }

  /* ── Services row ── */
  .service-row {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  .service-pill {
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--gold-accent);
    border: 1px solid var(--gold-accent);
    padding: 0.4rem 0.9rem;
    text-decoration: none;
    transition: all 0.15s;
  }

  .service-pill:hover {
    background: var(--gold-accent);
    color: var(--void);
  }

  /* ── Counter ── */
  .office-line {
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--white-30);
    margin: 0.6rem 0 0;
  }

  .counter-row {
    padding-top: 1.5rem;
    margin-top: 1.5rem;
    border-top: 1px solid var(--white-04);
  }

  /* ── Mobile ── */
  @media (max-width: 600px) {
    .service-row { flex-direction: column; }
    .service-pill { text-align: center; }
  }

  /* ── Pixel Grid Hover Texture ── */
  @media (hover: hover) {
    .project-card:hover, .essay-card:hover {
      background-image: url("data:image/svg+xml,%3Csvg width='2' height='2' xmlns='http://www.w3.org/2000/svg'%3E%3Crect width='1' height='1' fill='white' fill-opacity='0.04'/%3E%3C/svg%3E");
      background-size: 2px 2px;
    }
  }
</style>
