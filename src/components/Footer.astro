---
// Grouped, not a flat list.
//
// This had grown to ten links in one line — every new surface got appended
// until nothing had priority and the whole thing read as noise. A footer's job
// is one obvious next step plus a quiet index, not an inventory.
const year = new Date().getFullYear();

// One next step on every page: say hello.
const cta = { href: '/contact', lead: 'Get in touch', sub: 'or just say hello: alex@campos.works' };

const columns = [
  {
    title: 'the work',
    links: [
      { href: '/work', label: 'what I have built' },
      { href: '/projects', label: 'projects' },
      { href: '/resume', label: 'resume' },
    ],
  },
  {
    title: 'elsewhere',
    links: [
      { href: '/writing', label: 'writing' },
      { href: '/influences', label: 'influences' },
      { href: '/misc', label: 'glossary' },
      { href: '/contact', label: 'get in touch' },
    ],
  },
];
---

<footer>
  <!-- One obvious next step. Everything else is an index. -->
  <a class="footer-cta" href={cta.href}>
    <span class="cta-lead">{cta.lead}</span>
    <span class="cta-sub">{cta.sub}</span>
    <span class="cta-arrow" aria-hidden="true">→</span>
  </a>

  <nav class="footer-cols" aria-label="Footer">
    {
      columns.map((col) => (
        <div class="col">
          <h2>{col.title}</h2>
          <ul>
            {col.links.map((l) => (
              <li><a href={l.href}>{l.label}</a></li>
            ))}
          </ul>
        </div>
      ))
    }
  </nav>

  <div class="footer-base">
    <p class="copyright">alexander campos {year}</p>
    <p class="contact">
      <a href="mailto:alex@campos.works">alex@campos.works</a>
      <span aria-hidden="true">·</span>
      <a href="https://x.com/flapfinned" target="_blank" rel="noopener noreferrer">x</a>
      <span aria-hidden="true">·</span>
      <a href="https://github.com/notaprompt" target="_blank" rel="noopener noreferrer">github</a>
      <span aria-hidden="true">·</span>
      <a href="/guestbook">guestbook</a>
    </p>
    <p class="best-viewed">best viewed in a browser that respects view-source.</p>
  </div>
</footer>

<style>
  footer { padding-top: 1rem; margin-top: 4rem; }

  /* ── The one thing worth pressing ── */
  .footer-cta {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 0.2rem 1rem;
    padding: 0;
    text-decoration: none;
    margin-bottom: 2.8rem;
    transition: color 0.22s ease;
    position: relative;
  }
  .footer-cta:hover .cta-lead, .footer-cta:hover .cta-arrow { color: var(--gold-accent); }

  .cta-lead {
    font-family: var(--serif);
    font-size: 1.3rem;
    color: var(--glow-hot);
    line-height: 1.25;
  }
  .cta-sub {
    grid-column: 1;
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0;
    color: var(--white-45);
  }
  .cta-arrow {
    grid-row: 1 / span 2;
    grid-column: 2;
    font-family: var(--mono);
    font-size: 1.1rem;
    color: var(--white-20);
    transition: color 0.22s ease;
  }

  /* ── Grouped index ── */
  .footer-cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.6rem 2rem;
    margin-bottom: 2.2rem;
    text-align: left;
  }
  .col h2 {
    font-family: var(--mono);
    font-family: var(--serif);
    font-size: 1rem;
    letter-spacing: 0;
    text-transform: none;
    color: var(--glow);
    margin: 0 0 0.6rem;
    font-weight: 400;
  }
  .col ul { list-style: none; padding: 0; margin: 0; }
  .col li { margin-bottom: 0.32rem; }
  .col a {
    font-size: 0.84rem;
    color: var(--white-60);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color 0.16s, border-color 0.16s;
  }
  .col a:hover { color: var(--glow-hot); border-bottom-color: var(--gold-accent); }

  /* ── Base line ── */
  .footer-base { padding-top: 1.1rem; text-align: center; }
  .copyright {
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--white-30);
    margin-bottom: 0.3rem;
  }
  .contact {
    font-family: var(--mono);
    font-size: 0.7rem;
    margin-bottom: 0.4rem;
    color: var(--white-20);
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .contact a { color: var(--white-45); text-decoration: none; transition: color 0.16s; }
  .contact a:hover { color: var(--gold-accent); }
  .best-viewed {
    font-family: var(--mono);
    font-size: 0.65rem;
    color: var(--white-20);
    font-style: normal;
  }

  @media (max-width: 620px) {
    .footer-cols { grid-template-columns: 1fr 1fr; gap: 1.3rem 1rem; }
    .cta-lead { font-size: 1rem; }
  }
  @media (max-width: 380px) {
    .footer-cols { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .footer-cta::after { display: none; }
    .footer-cta, .cta-arrow { transition: none; }
  }
</style>
