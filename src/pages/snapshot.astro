---
import Page from '../layouts/Page.astro';

const title = 'business snapshot — campos.works';
const description =
  'Free, honest read on your business in about a minute. Where you leak money, who you are up against, and whether an AI assistant would ever recommend you. No login.';
---

<Page title={title} description={description}>
  <article class="snap" data-snapshot>
    <!-- ── 1. Input ─────────────────────────────────── -->
    <section class="phase phase--active" data-phase="input">
      <p class="eyebrow">free · about a minute · no login</p>
      <h1>Where does your business actually stand?</h1>
      <p class="lede">
        Give me your website. I read it the way a customer would, then check what
        the rest of the internet says about you — reviews, search, and whether an
        AI assistant would ever put your name forward. You get the leaks, priced,
        and what to do first.
      </p>

      <div class="input-row">
        <input
          type="text"
          id="url"
          placeholder="yourbusiness.com"
          autocomplete="url"
          autocapitalize="off"
          autocorrect="off"
          spellcheck="false"
          aria-label="Your website address"
        />
        <button id="go" type="button">Read my business →</button>
      </div>
      <p class="err" data-err hidden></p>

      <button class="linkish" type="button" data-toggle-describe>
        No website? Describe the business instead →
      </button>

      <div class="describe" data-describe hidden>
        <label for="describe">
          Tell me what you do, where, and who for. A couple of sentences is plenty.
        </label>
        <textarea
          id="describe"
          rows="4"
          placeholder="We do lawn maintenance and hardscaping for homeowners around Woodbridge and Manassas, VA. Mostly weekly cuts plus mulch and patios in spring."
        ></textarea>
        <button class="btn btn-primary" type="button" data-go-describe>Read my business →</button>
      </div>

      <ul class="reassure">
        <li>Free, and it stays free — this is not a trial.</li>
        <li>If your business is in good shape, it says so. I would rather you kept your money.</li>
        <li>I read every one of these myself.</li>
      </ul>
    </section>

    <!-- ── 2. Working ───────────────────────────────── -->
    <section class="phase" data-phase="working">
      <h2>Reading your business</h2>
      <ol class="steps" data-steps>
        <li data-step="crawl"><span class="dot"></span>Reading your site the way a customer would</li>
        <li data-step="classify"><span class="dot"></span>Working out what trade you're in</li>
        <li data-step="score"><span class="dot"></span>Grading the eight parts of the business</li>
        <li data-step="presence"><span class="dot"></span>Checking reviews, search, and directories</li>
        <li data-step="assistant"><span class="dot"></span>Asking an AI assistant if it knows you</li>
        <li data-step="judge"><span class="dot"></span>Pricing the leaks</li>
      </ol>
      <p class="working-note">
        This takes about a minute. It is doing real work — reading your pages,
        checking DNS, running searches — not showing you a fake progress bar.
      </p>
    </section>

    <!-- ── 3. Teaser + gate ─────────────────────────── -->
    <section class="phase" data-phase="gate">
      <div data-teaser></div>

      <div class="gate">
        <h2>One thing before I show you</h2>
        <p class="gate-why">
          The report is ready and it opens on the next screen — you do not need to
          check your inbox for it. I ask for a name and email because I read every
          one of these myself and sometimes follow up with the single thing I would
          fix first. There is no mailing list waiting for you.
        </p>

        <form class="gate-form" data-gate-form novalidate>
          <div class="field">
            <label for="lead-name">Your name</label>
            <input type="text" id="lead-name" name="name" autocomplete="name" required />
            <span class="field-err" data-field-err="name"></span>
          </div>
          <div class="field">
            <label for="lead-email">Email</label>
            <input type="email" id="lead-email" name="email" autocomplete="email" inputmode="email" required />
            <span class="field-err" data-field-err="email"></span>
          </div>

          <!-- Honeypot. Off-screen, not display:none, so bots still fill it. -->
          <div class="hp" aria-hidden="true">
            <label for="website_url">Leave this empty</label>
            <input type="text" id="website_url" name="website_url" tabindex="-1" autocomplete="off" />
          </div>

          <button type="submit" class="btn btn-primary btn-wide" data-unlock>Show me the report</button>
          <p class="err" data-gate-err hidden></p>
          <p class="gate-fine">
            No list, no sequence, no sharing it with anyone. You get a link you can
            keep or forward. Reply "stop" once and you will never hear from me again.
          </p>
        </form>
      </div>
    </section>

    <!-- ── 4. The report ────────────────────────────── -->
    <section class="phase" data-phase="report">
      <div class="report-bar no-print">
        <span class="report-badge" data-report-meta></span>
        <div class="report-actions">
          <button type="button" class="mini" data-clip>Clip mode</button>
          <button type="button" class="mini" onclick="window.print()" data-print>Download PDF</button>
          <button type="button" class="mini" data-copy-link>Copy link</button>
        </div>
      </div>
      <div data-report></div>
    </section>
  </article>

  <script is:inline src="/islands/snapshot.js"></script>
</Page>

<style>
  .snap { max-width: 100%; }
  .phase { display: none; }
  .phase--active { display: block; animation: snapIn 0.35s ease; }
  @keyframes snapIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }

  .eyebrow {
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold-accent);
    margin-bottom: 0.8rem;
  }
  .snap h1 {
    font-size: clamp(1.8rem, 5.4vw, 2.7rem);
    line-height: 1.1;
    margin-bottom: 0.85rem;
    text-wrap: balance;
  }
  .lede {
    font-size: 1rem;
    color: var(--white-70);
    line-height: 1.68;
    max-width: 58ch;
    margin-bottom: 1.5rem;
  }

  .input-row { display: flex; gap: 0.5rem; margin-bottom: 0.6rem; flex-wrap: wrap; }
  #url {
    flex: 1 1 16rem;
    background: var(--depth-2);
    border: 1px solid var(--white-15);
    color: var(--glow);
    padding: 0.85rem 1rem;
    font-family: var(--mono);
    font-size: 0.92rem;
    border-radius: 0;
  }
  #url::placeholder { color: var(--white-30); }
  #url:focus { outline: none; border-color: var(--gold-accent); }
  #go {
    background: var(--gold-accent);
    color: var(--void);
    border: 1px solid var(--gold-accent);
    padding: 0.85rem 1.5rem;
    font-family: var(--mono);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.16s, color 0.16s;
  }
  #go:hover { background: transparent; color: var(--gold-accent); }
  #go:disabled { opacity: 0.55; cursor: wait; }

  .err {
    font-family: var(--mono);
    font-size: 0.76rem;
    color: var(--danger);
    margin: 0.5rem 0;
    line-height: 1.5;
  }

  .linkish {
    background: none;
    border: none;
    padding: 0;
    font-family: var(--mono);
    font-size: 0.76rem;
    color: var(--gold-accent);
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .describe { margin-top: 1rem; }
  .describe label {
    display: block;
    font-size: 0.85rem;
    color: var(--white-60);
    margin-bottom: 0.45rem;
    line-height: 1.55;
  }
  #describe {
    width: 100%;
    background: var(--depth-2);
    border: 1px solid var(--white-15);
    color: var(--glow);
    padding: 0.8rem 0.9rem;
    font-family: var(--body);
    font-size: 0.9rem;
    line-height: 1.6;
    resize: vertical;
    border-radius: 0;
    margin-bottom: 0.6rem;
  }
  #describe:focus { outline: none; border-color: var(--gold-accent); }

  .reassure {
    list-style: none;
    padding: 0;
    margin: 1.8rem 0 0;
    border-top: 1px solid var(--white-08);
    padding-top: 1rem;
  }
  .reassure li {
    font-size: 0.82rem;
    color: var(--white-45);
    padding: 0.28rem 0 0.28rem 1.1rem;
    position: relative;
    line-height: 1.55;
  }
  .reassure li::before {
    content: '·';
    position: absolute;
    left: 0.25rem;
    color: var(--gold-accent);
  }

  /* ── Working ── */
  .steps { list-style: none; padding: 0; margin: 1.2rem 0; counter-reset: s; }
  .steps li {
    font-family: var(--mono);
    font-size: 0.84rem;
    color: var(--white-30);
    padding: 0.5rem 0 0.5rem 1.7rem;
    position: relative;
    transition: color 0.3s;
    line-height: 1.5;
  }
  .steps .dot {
    position: absolute;
    left: 0.15rem;
    top: 0.85rem;
    width: 7px;
    height: 7px;
    border: 1px solid var(--white-20);
    border-radius: 50%;
    transition: all 0.3s;
  }
  .steps li[data-state='active'] { color: var(--glow); }
  .steps li[data-state='active'] .dot {
    border-color: var(--gold-accent);
    background: var(--gold-accent);
    animation: pulse 1.1s ease-in-out infinite;
  }
  .steps li[data-state='done'] { color: var(--white-45); }
  .steps li[data-state='done'] .dot { border-color: var(--alive); background: var(--alive); }
  @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.35; } }
  .working-note {
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--white-30);
    max-width: 52ch;
    line-height: 1.6;
  }

  /* ── Gate ── */
  .gate {
    border: 1px solid var(--gold-accent);
    background: var(--depth-2);
    padding: 1.5rem 1.4rem;
    margin-top: 1.6rem;
  }
  .gate h2 { margin-top: 0; margin-bottom: 0.5rem; font-size: 1.3rem; }
  .gate-why {
    font-size: 0.88rem;
    color: var(--white-60);
    line-height: 1.62;
    max-width: 54ch;
    margin-bottom: 1.1rem;
  }
  .gate-form { max-width: 26rem; }
  .field { margin-bottom: 0.85rem; }
  .field label {
    display: block;
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--white-45);
    margin-bottom: 0.32rem;
  }
  .field input {
    width: 100%;
    background: var(--depth-1);
    border: 1px solid var(--white-15);
    color: var(--glow);
    padding: 0.7rem 0.85rem;
    font-family: var(--mono);
    font-size: 0.88rem;
    border-radius: 0;
  }
  .field input:focus { outline: none; border-color: var(--gold-accent); }
  .field input[aria-invalid='true'] { border-color: var(--danger); }
  .field-err {
    display: block;
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--danger);
    margin-top: 0.28rem;
    line-height: 1.45;
  }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .btn-wide { width: 100%; text-align: center; }
  .gate-fine {
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--white-30);
    margin-top: 0.7rem;
    line-height: 1.55;
  }

  .btn {
    display: inline-block;
    font-family: var(--mono);
    font-size: 0.82rem;
    padding: 0.78rem 1.4rem;
    text-decoration: none;
    border: 1px solid var(--gold-accent);
    cursor: pointer;
    transition: background 0.16s, color 0.16s;
  }
  .btn-primary { background: var(--gold-accent); color: var(--void); font-weight: 600; }
  .btn-primary:hover { background: transparent; color: var(--gold-accent); }
  .btn-primary:disabled { opacity: 0.55; cursor: wait; }

  /* ── Report chrome ── */
  .report-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    padding-bottom: 0.8rem;
    margin-bottom: 1.4rem;
    border-bottom: 1px solid var(--white-08);
  }
  .report-badge { font-family: var(--mono); font-size: 0.7rem; color: var(--white-30); }
  .report-actions { display: flex; gap: 0.4rem; flex-wrap: wrap; }
  .mini {
    background: transparent;
    border: 1px solid var(--white-15);
    color: var(--white-60);
    font-family: var(--mono);
    font-size: 0.7rem;
    padding: 0.4rem 0.75rem;
    cursor: pointer;
    transition: border-color 0.16s, color 0.16s;
  }
  .mini:hover { border-color: var(--gold-accent); color: var(--gold-accent); }

  @media print {
    .no-print, header, footer, nav { display: none !important; }
    .phase { display: none !important; }
    .phase[data-phase='report'] { display: block !important; }
  }
</style>

<style is:global>
  /* ── Report body. Global because the island injects this markup. ── */
  /* ── Prepared-for-you banner (cold outreach) ── */
  .prepared {
    border: 1px solid var(--alive);
    background: var(--alive-dim);
    padding: 0.95rem 1.15rem;
    margin-bottom: 1.2rem;
  }
  .prep-lab {
    display: block;
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--alive);
    margin-bottom: 0.4rem;
  }
  .prepared p {
    font-size: 0.87rem;
    color: var(--white-70);
    line-height: 1.62;
    margin: 0;
    max-width: 62ch;
  }

  /* ── Corrections ── */
  .corrections {
    border: 1px solid var(--white-15);
    border-left: 2px solid var(--gold-accent);
    background: var(--depth-1);
    padding: 0.9rem 1.1rem;
    margin-bottom: 1.6rem;
  }
  .corr-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 0.35rem;
  }
  .corr-lab {
    font-family: var(--mono);
    font-size: 0.63rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold-accent);
  }
  .corr-toggle {
    background: none;
    border: none;
    padding: 0;
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--gold-accent);
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .corr-summary {
    font-size: 0.84rem;
    color: var(--white-60);
    line-height: 1.6;
    margin: 0;
    max-width: 62ch;
  }
  .corr-form { margin-top: 1rem; max-width: 30rem; }
  .corr-field { margin-bottom: 0.7rem; }
  .corr-field label {
    display: block;
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--white-45);
    margin-bottom: 0.28rem;
  }
  .corr-field input,
  .corr-field select,
  .corr-field textarea {
    width: 100%;
    background: var(--depth-2);
    border: 1px solid var(--white-15);
    color: var(--glow);
    padding: 0.6rem 0.75rem;
    font-family: var(--mono);
    font-size: 0.84rem;
    border-radius: 0;
  }
  .corr-field textarea {
    font-family: var(--body);
    font-size: 0.88rem;
    line-height: 1.55;
    resize: vertical;
  }
  .corr-field input:focus,
  .corr-field select:focus,
  .corr-field textarea:focus { outline: none; border-color: var(--gold-accent); }
  .corr-actions { display: flex; align-items: center; gap: 0.8rem; flex-wrap: wrap; margin-top: 0.9rem; }
  .corr-status { font-family: var(--mono); font-size: 0.72rem; color: var(--white-30); line-height: 1.5; }
  .corr-status--err { color: var(--danger); }

  .rep-hero { margin-bottom: 1.8rem; }
  .rep-hero .rep-name {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold-accent);
    margin-bottom: 0.5rem;
  }
  .rep-hero h2 {
    font-size: clamp(1.4rem, 4vw, 2rem);
    line-height: 1.18;
    margin: 0 0 0.7rem;
    text-wrap: balance;
  }
  .rep-what { font-size: 0.92rem; color: var(--white-60); margin-bottom: 1rem; max-width: 60ch; line-height: 1.6; }
  .rep-read { font-size: 0.97rem; color: var(--white-70); line-height: 1.72; max-width: 62ch; }

  .rep-tiles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 0.55rem;
    margin: 1.5rem 0;
  }
  .tile { border: 1px solid var(--white-08); padding: 0.85rem 0.9rem; background: var(--depth-1); }
  .tile .t-val {
    font-family: var(--serif);
    font-size: 1.7rem;
    line-height: 1;
    color: var(--glow-hot);
    font-variant-numeric: tabular-nums;
    display: block;
  }
  .tile .t-lab {
    font-family: var(--mono);
    font-size: 0.63rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--white-30);
    margin-top: 0.35rem;
    display: block;
    line-height: 1.4;
  }
  .tile--a .t-val, .tile--b .t-val { color: var(--alive); }
  .tile--c .t-val { color: var(--gold-accent); }
  .tile--d .t-val, .tile--f .t-val { color: var(--danger); }

  .rep-sec { margin: 2rem 0; }
  .rep-sec > h3 {
    font-family: var(--serif);
    font-size: 1.25rem;
    margin: 0 0 0.35rem;
    color: var(--glow-hot);
  }
  .rep-sec > .rep-gloss {
    font-size: 0.84rem;
    color: var(--white-45);
    margin-bottom: 0.9rem;
    max-width: 58ch;
    line-height: 1.6;
  }

  .leak {
    border-top: 1px solid var(--white-08);
    padding: 1rem 0;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.3rem 1rem;
  }
  .leak:last-child { border-bottom: 1px solid var(--white-08); }
  .leak-rank {
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--gold-accent);
    padding-top: 0.2rem;
  }
  .leak h4 { margin: 0 0 0.3rem; font-size: 1.02rem; color: var(--glow-hot); font-family: var(--serif); }
  .leak-cost {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--danger);
    font-variant-numeric: tabular-nums;
    margin-bottom: 0.4rem;
  }
  .leak-cost .basis { color: var(--white-30); font-size: 0.72rem; }
  .leak p { font-size: 0.87rem; color: var(--white-60); line-height: 1.62; margin: 0 0 0.4rem; max-width: 60ch; }
  .leak .leak-fix { color: var(--white-70); }
  .leak .leak-fix strong { color: var(--gold-accent); font-weight: 400; font-family: var(--mono); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.1em; }

  .swot { display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem; }
  .swot-q { border: 1px solid var(--white-08); padding: 0.9rem 1rem; background: var(--depth-1); }
  .swot-q h4 {
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin: 0 0 0.5rem;
  }
  .swot-q.s h4 { color: var(--alive); }
  .swot-q.w h4 { color: var(--danger); }
  .swot-q.o h4 { color: var(--gold-accent); }
  .swot-q.t h4 { color: var(--white-45); }
  .swot-q ul { list-style: none; padding: 0; margin: 0; }
  .swot-q li { font-size: 0.82rem; color: var(--white-60); padding: 0.26rem 0; line-height: 1.55; }

  .part-row { border-top: 1px solid var(--white-08); padding: 0.85rem 0; }
  .part-row:last-child { border-bottom: 1px solid var(--white-08); }
  .part-head { display: flex; align-items: baseline; gap: 0.7rem; margin-bottom: 0.4rem; flex-wrap: wrap; }
  .part-head .p-name { font-family: var(--serif); font-size: 1rem; color: var(--glow-hot); }
  .part-head .p-grade {
    font-family: var(--mono);
    font-size: 0.74rem;
    padding: 0.1rem 0.45rem;
    border: 1px solid;
    letter-spacing: 0.06em;
  }
  .g-A, .g-B { color: var(--alive); border-color: var(--alive); }
  .g-C { color: var(--gold-accent); border-color: var(--gold-accent); }
  .g-D, .g-F { color: var(--danger); border-color: var(--danger); }
  .g-x { color: var(--white-30); border-color: var(--white-15); border-style: dashed; }
  .findings { list-style: none; padding: 0; margin: 0; }
  .findings li {
    font-size: 0.82rem;
    padding: 0.22rem 0 0.22rem 1.2rem;
    position: relative;
    line-height: 1.55;
    color: var(--white-60);
    max-width: 62ch;
  }
  .findings li.gap { color: var(--white-70); }
  .findings li::before {
    position: absolute;
    left: 0;
    font-family: var(--mono);
    font-size: 0.7rem;
  }
  .findings li.ok::before { content: '✓'; color: var(--alive); }
  .findings li.gap::before { content: '✕'; color: var(--danger); }

  .probe { border-top: 1px solid var(--white-08); padding: 0.7rem 0; display: flex; gap: 0.8rem; align-items: baseline; flex-wrap: wrap; }
  .probe-label { font-family: var(--mono); font-size: 0.74rem; color: var(--white-45); min-width: 11rem; }
  .probe-val { font-size: 0.85rem; color: var(--white-70); flex: 1 1 14rem; line-height: 1.55; }
  .probe-val a { color: var(--gold-accent); }
  .probe-state {
    font-family: var(--mono);
    font-size: 0.6rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    padding: 0.1rem 0.4rem;
    border: 1px solid;
