---
// One surface. The practice nav went when the business pages came down.
const path = Astro.url.pathname;

const links = [
  { href: '/', label: 'home' },
  { href: '/work', label: 'work' },
  { href: '/writing', label: 'writing' },
  { href: '/about', label: 'about' },
  { href: '/contact', label: 'contact', accent: true },
];

const isActive = (href: string) => {
  const base = href.split('#')[0];
  return path === base || (base !== '/' && path.startsWith(base));
};
---

<nav aria-label="Main navigation">
  <ul>
    {links.map(link => (
      <li>
        <a
          href={link.href}
          class:list={[{ active: isActive(link.href) }, { 'nav-accent': link.accent }]}
        >
          {link.label}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  nav {
    border-top: 2px dashed var(--white-08);
    border-bottom: 2px dashed var(--white-08);
    padding: 0.6rem 0;
    margin-bottom: 0.5rem;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  a {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--white-45);
    text-decoration: none;
    text-transform: lowercase;
    border-bottom: none;
    transition: color 0.2s;
  }

  a:hover, a.active { color: var(--glow-hot); }

  .nav-accent { color: var(--gold-accent); }
  .nav-accent:hover, .nav-accent.active { color: var(--glow-hot); }

</style>
