---
// A one-bit animated figure for a project (generated by scripts/dither-thumbs.py).
// The PNG is a sprite strip used only as a mask; the colour comes from
// --gold-accent, so it follows the dark and light themes. Frame 0 is the still;
// hovering or focusing the card plays the loop.
import marks from '../../public/images/thumbs/marks.json';

interface Props { slug: string; size?: 64 | 96; caption?: boolean }
const { slug, size = 64, caption = false } = Astro.props;
const frames = marks.frames;
const text = (marks.captions as Record<string, string>)[slug];
---

<figure class="dither-fig" aria-hidden="true">
  <span
    class="dither-thumb"
    style={`--thumb: url(/images/thumbs/${slug}-${size}.png); --size: ${size}px; --frames: ${frames}`}
  ></span>
  {caption && text && <figcaption>{text}</figcaption>}
</figure>

<style is:global>
  .dither-fig { margin: 0; flex: none; }
  .dither-thumb {
    display: block;
    width: var(--size);
    height: var(--size);
    background: var(--gold-accent);
    opacity: 0.82;
    -webkit-mask-image: var(--thumb);
    mask-image: var(--thumb);
    -webkit-mask-size: calc(var(--frames) * 100%) 100%;
    mask-size: calc(var(--frames) * 100%) 100%;
    -webkit-mask-position: 0 0;
    mask-position: 0 0;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    transition: opacity 0.2s ease;
  }
  .dither-fig figcaption {
    margin-top: 0.45rem;
    font-family: var(--mono);
    font-size: 0.58rem;
    line-height: 1.35;
    letter-spacing: 0.02em;
    color: var(--white-30);
    max-width: 96px;
  }
  @keyframes dither-play {
    from { -webkit-mask-position: 0 0; mask-position: 0 0; }
    to { -webkit-mask-position: 100% 0; mask-position: 100% 0; }
  }
  :is(a, div).project-card:hover .dither-thumb,
  :is(a, div).project-card:focus-within .dither-thumb,
  a.project-card:focus-visible .dither-thumb {
    opacity: 1;
    animation: dither-play 1.8s steps(12, jump-none) infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    :is(a, div).project-card:hover .dither-thumb,
    :is(a, div).project-card:focus-within .dither-thumb { animation: none; }
  }
</style>
