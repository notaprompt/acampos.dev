---
import Page from '../../layouts/Page.astro';
import { glossary } from '../../data/glossary';

const sortedEntries = Object.entries(glossary).sort((a, b) =>
  a[1].term.localeCompare(b[1].term)
);

const currentPath = Astro.url.pathname;
---

<Page title="glossary -- alexander campos" description="Plain-language definitions for terms used in the projects and writing.">
  <article>
    <nav class="subnav" aria-label="Misc sections">
      <a href="/misc" class:list={[{ active: currentPath === '/misc' || currentPath === '/misc/' }]}>glossary</a>
      <a href="/misc/hall-of-shame" class:list={[{ active: currentPath.startsWith('/misc/hall-of-shame') }]}>project archive</a>
    </nav>

    <h1>Glossary</h1>

    <p class="intro">
      Short definitions for terms used in the <a href="/projects">projects</a> and
      <a href="/writing">writing</a>. They are a starting point for reading the work,
      rather than a substitute for the sources linked in each essay.
    </p>

    <dl class="glossary-list">
      {sortedEntries.map(([slug, entry]) => (
        <div class="glossary-entry" id={`gloss-${slug}`}>
          <dt>{entry.term}</dt>
          <dd>{entry.definition}</dd>
        </div>
      ))}
    </dl>
  </article>
</Page>

<style>
  .subnav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    font-size: 0.95rem;
    margin-bottom: 2rem;
    color: var(--white-30);
  }

  .subnav a {
    color: var(--white-45);
    text-decoration: none;
    border-bottom: none;
    transition: color 0.2s;
  }

  .subnav a:hover {
    color: var(--gold-accent);
  }

  .subnav a.active {
    color: var(--glow);
  }

  h1 {
    margin-bottom: 0.5rem;
  }

  .intro {
    margin-bottom: 2.5rem;
    color: var(--white-60);
    line-height: 1.65;
  }

  .glossary-list {
    margin-top: 1.5rem;
  }

  .glossary-entry {
    margin-bottom: 1.75rem;
    scroll-margin-top: 5rem;
  }

  dt {
    font-family: var(--serif);
    font-size: 1.1rem;
    font-weight: 400;
    color: var(--glow-hot);
    margin-bottom: 0.4rem;
  }

  dd {
    color: var(--glow);
    line-height: 1.65;
    margin: 0;
  }
</style>
