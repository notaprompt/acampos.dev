---
import Page from '../../layouts/Page.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  // Hidden micro entries remain available for existing deep links.
  const projects = await getCollection('projects');
  const micro = await getCollection('micro');
  return [...projects, ...micro].map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
type Shot = { src: string; caption?: string };
const shots: Shot[] = (entry.data.screenshots ?? []).map((shot: string | Shot) =>
  typeof shot === 'string' ? { src: shot } : shot,
);
if (!shots.length && entry.data.image) shots.push({ src: entry.data.image });
const download = 'download' in entry.data ? entry.data.download : undefined;
const statusText = {
  active: 'In development',
  shipped: 'Shipped',
  parked: 'Parked',
  absorbed: 'Continued in ForgeFrame',
  concept: 'Concept',
};
---

<Page
  title={`${entry.data.title} -- alexander campos`}
  description={entry.data.tagline}
  ogType="article"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": entry.data.status === 'concept' ? 'CreativeWork' : 'SoftwareSourceCode',
    "name": entry.data.title,
    "description": entry.data.tagline,
    "url": `https://campos.works/projects/${entry.slug}`,
    ...(entry.data.repo ? { "codeRepository": entry.data.repo } : {}),
    ...(entry.data.demo ? { "targetProduct": { "@type": "WebApplication", "url": entry.data.demo } } : {}),
    "programmingLanguage": entry.data.stack,
    "author": {
      "@type": "Person",
      "name": "Alexander Campos",
      "url": "https://campos.works"
    },
    "creativeWorkStatus": entry.data.status === 'shipped' ? 'Published' : entry.data.status === 'active' ? 'In development' : entry.data.status === 'absorbed' ? 'Discontinued' : entry.data.status === 'parked' ? 'Paused' : 'Concept'
  })} />

  <article class="project-detail">
    <header class="project-header">
      <h1>{entry.data.title}</h1>
      <p class="tagline">{entry.data.tagline}</p>
      <div class="project-meta">
        <span>{statusText[entry.data.status]}</span>
        {entry.data.repo && <a href={entry.data.repo}>Source</a>}
        {entry.data.demo && <a href={entry.data.demo}>Visit site</a>}
        {download && <a href={download}>Download</a>}
      </div>
    </header>

    <div class="project-content">
      <Content />
    </div>

    {shots.length > 0 && (
      <div class="project-screenshots">
        {shots.map((shot, i) => (
          <figure class="project-screenshot">
            <img
              src={shot.src}
              alt={shot.caption ?? `${entry.data.title} screenshot ${i + 1}`}
              loading="lazy"
              decoding="async"
            />
            {shot.caption && <figcaption>{shot.caption}</figcaption>}
          </figure>
        ))}
      </div>
    )}

    <nav class="back-nav" aria-label="Projects">
      <a href="/projects">All projects</a>
    </nav>
  </article>
</Page>

<style>
  .project-header {
    margin-bottom: 2.5rem;
  }

  .tagline {
    font-size: 1.2rem;
    line-height: 1.6;
    color: var(--glow);
    margin-bottom: 0.8rem;
  }

  .project-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.25rem;
    font-family: var(--mono);
    font-size: 0.72rem;
    line-height: 1.6;
    color: var(--white-45);
  }

  .project-content :global(h2) {
    margin-top: 2.5rem;
  }

  .project-content :global(pre) {
    font-size: 0.8rem;
  }

  .project-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .project-screenshots {
    display: grid;
    gap: 2rem;
    margin-top: 3rem;
  }

  .project-screenshot {
    margin: 0;
  }

  .project-screenshot img {
    width: 100%;
    height: auto;
    display: block;
  }

  .project-screenshot figcaption {
    margin-top: 0.75rem;
    font-family: var(--mono);
    font-size: 0.72rem;
    line-height: 1.6;
    color: var(--white-45);
  }

  .back-nav {
    margin-top: 3rem;
    font-family: var(--mono);
    font-size: 0.75rem;
  }
</style>
