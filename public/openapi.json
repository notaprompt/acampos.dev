{
  "openapi": "3.1.0",
  "info": {
    "title": "campos.works Agent API",
    "description": "Public read-only endpoints for Alexander Campos's site profile. No auth required.",
    "version": "1.0.0",
    "contact": {
      "name": "Alexander Campos",
      "email": "alex@campos.works",
      "url": "https://campos.works"
    }
  },
  "servers": [
    {
      "url": "https://campos.works",
      "description": "Production"
    }
  ],
  "paths": {
    "/api/agent/profile": {
      "get": {
        "operationId": "getAgentProfile",
        "summary": "Get full capability manifest",
        "description": "Returns structured data about background, projects built, technical capabilities, and machine-readable discovery endpoints.",
        "responses": {
          "200": {
            "description": "Capability manifest",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentProfile"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AgentProfile": {
        "type": "object",
        "properties": {
          "schema_version": {
            "type": "string"
          },
          "person": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "website": {
                "type": "string"
              }
            }
          },
          "projects": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                }
              }
            }
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "actions": {
            "type": "object"
          },
          "discovery": {
            "type": "object"
          },
          "last_updated": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}