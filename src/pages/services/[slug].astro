---
import Page from '../../layouts/Page.astro';
import { PARTS, partBySlug } from '../../data/services';

export function getStaticPaths() {
  return PARTS.map((part) => ({ params: { slug: part.slug }, props: { part } }));
}

const { part } = Astro.props;
const related = part.pairsWith
  .map((s) => partBySlug(s))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));

const idx = PARTS.findIndex((p) => p.slug === part.slug);
const prev = PARTS[(idx - 1 + PARTS.length) % PARTS.length];
const next = PARTS[(idx + 1) % PARTS.length];
---

<Page
  title={`${part.name.toLowerCase()} — services — alexander campos`}
  description={part.summary}
>
  <article class="part-page">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/services">services</a>
      <span aria-hidden="true">/</span>
      <span>{part.name.toLowerCase()}</span>
    </nav>

    <header>
      <p class="eyebrow">part {String(idx + 1).padStart(2, '0')} of 08</p>
      <h1>{part.name}</h1>
      <p class="question">“{part.question}”</p>
      <p class="summary">{part.summary}</p>
      <div class="facts">
        <span><b>${part.priceFrom.toLocaleString()}–${part.priceTo.toLocaleString()}</b> typical</span>
        <span><b>{part.timeline}</b> to build</span>
      </div>
      <p class="price-note">{part.priceNote}</p>
    </header>

    <hr />

    <section class="leak">
      <h2>What this actually costs you</h2>
      <p>{part.theLeak}</p>
    </section>

    <hr />

    <section>
      <h2>What gets built</h2>
      <ul class="ticks">
        {part.whatYouGet.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section>
      <h2>How we know it worked</h2>
      <p class="sub">
        Measured before and after. If the number does not move, I would rather
        know that than have you assume it did.
      </p>
      <ul class="measures">
        {part.howWeMeasure.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <hr />

    <section>
      <h2>Why me for this one</h2>
      <div class="proofs">
        {
          part.proof.map((p) => (
            <div class="proof">
              <p class="claim">{p.claim}</p>
              <p class="evidence">
                {p.href ? (
                  <a href={p.href} target={p.href.startsWith('http') ? '_blank' : undefined} rel={p.href.startsWith('http') ? 'noopener' : undefined}>
                    {p.evidence}
                  </a>
                ) : (
                  p.evidence
                )}
              </p>
            </div>
          ))
        }
      </div>
    </section>

    <hr />

    <section class="cta-block">
      <h2>Find out if this is your problem</h2>
      <p>
        The free Snapshot grades this part of your business along with the other
        seven, using what it can actually observe. It takes about a minute and
        tells you the truth even when the truth is that you are fine.
      </p>
      <div class="cta-row">
        <a class="btn btn-primary" href="/snapshot">Run my Snapshot</a>
        <a class="btn btn-ghost" href={`/contact?part=${part.slug}`}>Talk about this specifically</a>
      </div>
    </section>

    {
      related.length > 0 && (
        <section class="related">
          <h2>Usually fixed alongside</h2>
          <div class="rel-row">
            {related.map((r) => (
              <a class="rel" href={`/services/${r.slug}`}>
                <span class="rel-name">{r.name}</span>
                <span class="rel-sum">{r.summary}</span>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <nav class="pager" aria-label="Other parts">
      <a href={`/services/${prev.slug}`} class="pager-link">
        <span class="dir">← previous</span>
        <span class="pname">{prev.name}</span>
      </a>
      <a href={`/services/${next.slug}`} class="pager-link pager-next">
        <span class="dir">next →</span>
        <span class="pname">{next.name}</span>
      </a>
    </nav>
  </article>
</Page>

<style>
  .crumb {
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--white-30);
    margin-bottom: 1.4rem;
    display: flex;
    gap: 0.5rem;
  }
  .crumb a { color: var(--gold-accent); text-decoration: none; }
  .crumb a:hover { text-decoration: underline; }

  .eyebrow {
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold-accent);
    margin-bottom: 0.7rem;
  }
  .part-page h1 {
    font-size: clamp(1.8rem, 5vw, 2.6rem);
    line-height: 1.1;
    margin-bottom: 0.7rem;
  }
  .question {
    font-family: var(--mono);
    font-size: 0.92rem;
    color: var(--gold-accent);
    line-height: 1.55;
    margin-bottom: 0.9rem;
  }
  .summary {
    font-size: 1rem;
    color: var(--white-70);
    line-height: 1.65;
    max-width: 60ch;
    margin-bottom: 1.1rem;
  }
  .facts {
    display: flex;
    gap: 1.6rem;
    flex-wrap: wrap;
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--white-45);
    margin-bottom: 0.4rem;
  }
  .facts b { color: var(--glow); font-weight: 400; font-variant-numeric: tabular-nums; }
  .price-note {
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--white-30);
    max-width: 54ch;
    line-height: 1.6;
  }

  .part-page h2 {
    font-size: 1.3rem;
    margin-top: 0;
    margin-bottom: 0.7rem;
  }
  .leak p {
    font-size: 0.95rem;
    color: var(--white-70);
    line-height: 1.7;
    max-width: 64ch;
    border-left: 2px solid var(--gold-accent);
    padding-left: 1.1rem;
  }
  .sub {
    font-size: 0.86rem;
    color: var(--white-45);
    max-width: 58ch;
    margin-bottom: 0.8rem;
    line-height: 1.6;
  }

  .ticks, .measures { list-style: none; padding: 0; margin: 0 0 1.6rem; }
  .ticks li, .measures li {
    font-size: 0.9rem;
    color: var(--white-60);
    padding: 0.4rem 0 0.4rem 1.5rem;
    position: relative;
    line-height: 1.6;
    border-top: 1px solid var(--white-04);
    max-width: 62ch;
  }
  .ticks li::before {
    content: '→';
    position: absolute;
    left: 0;
    top: 0.4rem;
    color: var(--gold-accent);
    font-family: var(--mono);
    font-size: 0.78rem;
  }
  .measures li::before {
    content: '▪';
    position: absolute;
    left: 0.2rem;
    top: 0.4rem;
    color: var(--alive);
    font-size: 0.7rem;
  }

  .proofs { display: flex; flex-direction: column; gap: 0.75rem; }
  .proof {
    border: 1px solid var(--white-08);
    padding: 0.95rem 1.1rem;
    background: var(--depth-1);
  }
  .claim {
    font-size: 0.9rem;
    color: var(--white-70);
    line-height: 1.6;
    margin-bottom: 0.4rem;
  }
  .evidence {
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--white-30);
    margin: 0;
  }
  .evidence a { color: var(--gold-accent); }

  .cta-block h2 { margin-bottom: 0.5rem; }
  .cta-block p {
    font-size: 0.92rem;
    color: var(--white-60);
    max-width: 58ch;
    line-height: 1.65;
    margin-bottom: 1.1rem;
  }
  .cta-row { display: flex; gap: 0.6rem; flex-wrap: wrap; }
  .btn {
    display: inline-block;
    font-family: var(--mono);
    font-size: 0.8rem;
    padding: 0.7rem 1.3rem;
    text-decoration: none;
    border: 1px solid var(--gold-accent);
    transition: background 0.16s, color 0.16s, border-color 0.16s;
  }
  .btn-primary { background: var(--gold-accent); color: var(--void); font-weight: 600; }
  .btn-primary:hover { background: transparent; color: var(--gold-accent); }
  .btn-ghost { background: transparent; color: var(--gold-accent); border-color: var(--white-15); }
  .btn-ghost:hover { border-color: var(--gold-accent); }

  .related { margin-top: 2.2rem; }
  .rel-row { display: grid; grid-template-columns: 1fr 1fr; gap: 0.7rem; }
  .rel {
    border: 1px solid var(--white-08);
    padding: 0.9rem 1rem;
    text-decoration: none;
    display: block;
    transition: border-color 0.18s;
  }
  .rel:hover { border-color: var(--gold-accent); }
  .rel-name {
    display: block;
    font-family: var(--serif);
    font-size: 1rem;
    color: var(--glow-hot);
    margin-bottom: 0.25rem;
  }
  .rel-sum { display: block; font-size: 0.78rem; color: var(--white-45); line-height: 1.5; }

  .pager {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2.5rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--white-08);
  }
  .pager-link { text-decoration: none; display: block; max-width: 45%; }
  .pager-next { text-align: right; }
  .dir {
    display: block;
    font-family: var(--mono);
    font-size: 0.68rem;
    color: var(--white-30);
    margin-bottom: 0.2rem;
  }
  .pname { font-family: var(--serif); font-size: 0.95rem; color: var(--gold-accent); }

  @media (max-width: 600px) {
    .rel-row { grid-template-columns: 1fr; }
  }
</style>
