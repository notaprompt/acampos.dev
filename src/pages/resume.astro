<style>
  .resume {
    font-size: 0.95rem;
  }

  .skills {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--white-60);
  }

  .role {
    margin-bottom: 2rem;
  }

  .role-header {
    margin-bottom: 0.75rem;
  }

  .role-header h3 {
    margin-bottom: 0.15rem;
  }

  .dates {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--white-45);
  }

  .role ul {
    padding-left: 1.25rem;
  }

  .role li {
    margin-bottom: 0.75rem;
  }

  .role li strong {
    color: var(--glow-hot);
  }

  .resume-contact {
    text-align: center;
  }

  .resume-contact p {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--white-45);
  }
  .stats {
    list-style: none; padding: 0; margin: 0 0 1.6rem;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    border-top: 1px solid var(--white-15); border-bottom: 1px solid var(--white-15);
  }
  .stats li { padding: 0.75rem 0.9rem 0.75rem 0; border-right: 1px solid var(--white-08); display: flex; flex-direction: column; gap: 0.15rem; }
  .stats li:last-child { border-right: none; }
  .stats b { font-family: var(--mono); font-size: 1.05rem; color: var(--gold-accent); font-weight: 600; letter-spacing: -0.01em; }
  .stats span { font-size: 0.74rem; color: var(--white-45); line-height: 1.3; }
  @media (max-width: 480px) { .stats { grid-template-columns: 1fr 1fr; } .stats li { border-right: none; } }
</style>
