---
import Page from '../layouts/Page.astro';
---

<Page title="contact -- alexander campos" description="Get in touch about the work, the writing, or a question worth comparing notes on.">
  <article class="contact">
    <h1>Get in touch</h1>
    <p>
      If something I wrote or built connects with your work, I’d like to hear about it.
      Questions, corrections, and a simple hello are welcome.
    </p>
    <p><a href="mailto:alex@campos.works">alex@campos.works</a></p>
    <ul class="links">
      <li><a href="https://linkedin.com/in/alexander-d-campos" target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
      <li><a href="https://github.com/notaprompt" target="_blank" rel="noopener noreferrer">GitHub</a></li>
      <li><a href="https://x.com/flapfinned" target="_blank" rel="noopener noreferrer">X (@flapfinned)</a></li>
    </ul>
  </article>
</Page>

<style>
  .contact { max-width: 58ch; }
  .contact p { color: var(--white-70); }
  .links { list-style: none; padding: 0; margin: 2rem 0; display: flex; flex-wrap: wrap; gap: 0.75rem 1.5rem; }
</style>
