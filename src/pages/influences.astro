---
import Page from '../layouts/Page.astro';

const sections = [
  {
    category: 'Systems & Cybernetics',
    people: [
      { name: 'Douglas Hofstadter', note: 'Self-reference, formal systems, and the difference between a useful model of a mind and a claim about what a machine experiences.' },
      { name: 'Karl Friston', note: 'A vocabulary for thinking about prediction, feedback, and adaptation. I use it to form questions about my systems, not to treat them as biological equivalents.' },
      { name: 'Norbert Wiener', note: 'Cybernetics, and what happens when the feedback loop includes a human being.' },
      { name: 'Niklas Luhmann', note: 'Connected notes as working infrastructure: a way to find relationships without forcing everything into one hierarchy.' },
    ],
  },
  {
    category: 'Philosophy & Inner Life',
    people: [
      { name: 'Carl Jung', note: 'The process of becoming whole through what you\'d rather not look at.' },
      { name: 'Baruch Spinoza', note: 'Freedom as adequate understanding of what constrains you.' },
      { name: 'Marcus Aurelius', note: 'Governed an empire while writing private notes about governing himself. The notes lasted longer.' },
      { name: 'Augustine', note: 'The willingness to examine an earlier version of yourself without pretending you have finished changing.' },
      { name: 'Thomas Aquinas', note: 'Careful distinctions and serious treatment of objections before reaching a conclusion.' },
    ],
  },
  {
    category: 'History & Power',
    people: [
      { name: 'Ibn Khaldun', note: 'Behavioral observation as structural analysis, written from inside the collapse.' },
      { name: 'Michel Foucault', note: 'How observation and classification can change the people being observed. That question runs through my writing on personal AI.' },
      { name: 'Peter Turchin', note: 'An attempt to make historical explanations testable. The distinction between a pattern and a reliable forecast matters to my own experiments.' },
      { name: 'Jiang Xueqin', note: 'Historical comparison as a way to question the present, while keeping the limits of the comparison in view.' },
    ],
  },
  {
    category: 'Engineering & Building',
    people: [
      { name: 'Christopher Alexander', note: 'Start with how a place is used. Improve the parts in relation to the whole, rather than imposing a finished shape at the beginning.' },
      { name: 'Andrej Karpathy', note: 'Thinks before coding, ships simple things, and explains hard problems like someone who actually understands them.' },
      { name: 'Paul Graham', note: 'Writes clearly about building things, which turns out to be harder than building things.' },
      { name: 'Isaac Asimov', note: 'Imagined a science of historical prediction and then showed why it breaks when a single unpredictable actor appears.' },
    ],
  },
];
---

<Page title="influences -- alexander campos" description="People whose work shaped how I think about what I build.">
  <article>
    <h1>Influences</h1>

    <p class="influences-intro">
      A few of the people I return to when thinking about systems, responsibility,
      and how to build. These notes describe what I take from their work, not a claim
      that they would agree with mine.
    </p>

    {sections.map(section => (
      <section class="influence-section">
        <h2>{section.category}</h2>
        <ul class="influence-list">
          {section.people.map(person => (
            <li>
              <strong>{person.name}</strong>
              <span class="influence-dash">. </span>
              <span class="influence-note">{person.note}</span>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <section class="influence-section">
      <h2>Currently in rotation</h2>
      <ul class="rotation-list">
        <li>Shigeo Sekito</li>
        <li>Piero Piccioni</li>
        <li>Maison Music</li>
        <li>Nick Drake</li>
        <li>Blood Orange</li>
        <li>Mitu</li>
        <li>Lilen</li>
        <li>Latin Mafia</li>
        <li>54 Ultra</li>
        <li>A Flock of Seagulls</li>
        <li>Mojave</li>
        <li>Dean Blunt</li>
        <li>Panchiko</li>
        <li>Yves Tumor</li>
        <li>Aphex Twin</li>
        <li>Fontaines D.C.</li>
      </ul>
    </section>
  </article>

</Page>

<style>
  .influences-intro {
    font-size: 1rem;
    color: var(--white-60);
    margin-bottom: 2rem;
  }

  .influence-section {
    margin-bottom: 2rem;
  }

  .influence-list {
    list-style: none;
    padding-left: 0;
  }

  .influence-list li {
    color: var(--white-60);
    font-size: 0.95rem;
    margin-bottom: 1rem;
    line-height: 1.6;
  }

  .influence-list li strong {
    color: var(--glow);
    font-family: var(--serif);
    font-size: 1.05rem;
  }

  .influence-dash {
    color: var(--white-30);
  }

  .influence-note {
    color: var(--white-60);
  }

  .rotation-list {
    list-style: none;
    padding-left: 0;
    columns: 2;
    column-gap: 2rem;
  }

  .rotation-list li {
    font-size: 0.95rem;
    color: var(--white-60);
    margin-bottom: 0.4rem;
    break-inside: avoid;
  }
</style>
