---
import Page from '../../layouts/Page.astro';
import { getCollection } from 'astro:content';
import DitherThumb from '../../components/DitherThumb.astro';

const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const inUse = new Set(['active', 'shipped']);
const projects = all.filter((project) => inUse.has(project.data.status));
const earlier = all.filter((project) => !inUse.has(project.data.status));
const micro = (await getCollection('micro'))
  .filter((entry) => !entry.data.hidden)
  .sort((a, b) => a.data.order - b.data.order);

const statusText = {
  active: 'In development',
  shipped: 'Shipped',
  parked: 'Parked',
  absorbed: 'Continued in ForgeFrame',
  concept: 'Concept',
};
---

<Page
  title="projects -- alexander campos"
  description="Products, personal infrastructure, and experiments by Alexander Campos. What each does, the decisions behind it, and where it stands."
>
  <article class="projects">
    <h1>Projects</h1>
    <p class="intro">
      Products and tools built around work I wanted to do better: applying for a
      job, keeping context across sessions, finding useful reading, and testing a
      forecast.
    </p>

    <ul class="project-list">
      {projects.map(project => (
        <li class="project-entry">
          <DitherThumb slug={project.slug} size={64} />
          <div class="project-body">
            <h2><a href={`/projects/${project.slug}`}>{project.data.title}</a></h2>
            <p class="project-tagline">{project.data.tagline}</p>
            <div class="project-meta">
              <span>{statusText[project.data.status]}</span>
              {project.data.repo && <a href={project.data.repo}>Source</a>}
              {project.data.demo && <a href={project.data.demo}>Visit site</a>}
            </div>
          </div>
        </li>
      ))}
    </ul>

    {earlier.length > 0 && (
      <section class="project-section" aria-labelledby="earlier-heading">
        <h2 id="earlier-heading">Earlier work and ideas</h2>
        <p>Experiments that stopped, changed shape, or have yet to be built.</p>
        <ul class="project-list">
          {earlier.map(project => (
            <li class="project-entry">
              <DitherThumb slug={project.slug} size={64} />
              <div class="project-body">
                <h3><a href={`/projects/${project.slug}`}>{project.data.title}</a></h3>
                <p class="project-tagline">{project.data.tagline}</p>
                <div class="project-meta">
                  <span>{statusText[project.data.status]}</span>
                  {project.data.repo && <a href={project.data.repo}>Source</a>}
                  {project.data.demo && <a href={project.data.demo}>Visit site</a>}
                </div>
              </div>
            </li>
          ))}
        </ul>
      </section>
    )}

    {micro.length > 0 && (
      <section class="project-section" aria-labelledby="tools-heading">
        <h2 id="tools-heading">Small tools</h2>
        <p>Smaller fixes for things I kept running into.</p>
        <ul class="tool-list">
          {micro.map(entry => (
            <li>
              <h3><a href={`/projects/${entry.slug}`}>{entry.data.title}</a></h3>
              <p>{entry.data.tagline}</p>
              <div class="project-meta">
                {entry.data.repo && <a href={entry.data.repo}>Source</a>}
                {entry.data.download && <a href={entry.data.download}>Download</a>}
              </div>
            </li>
          ))}
        </ul>
      </section>
    )}

    <nav class="project-footer" aria-label="More project history">
      <a href="/misc/hall-of-shame">Projects I stopped</a>
    </nav>
  </article>
</Page>

<style>
  .intro {
    max-width: 39rem;
  }

  .project-list,
  .tool-list {
    list-style: none;
    padding: 0;
    margin: 2.5rem 0 0;
    display: grid;
    gap: 2.5rem;
  }

  .project-entry {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    gap: 1.25rem;
    align-items: start;
    margin: 0;
  }

  .project-body {
    min-width: 0;
  }

  .project-body h2,
  .project-body h3,
  .tool-list h3 {
    font-size: 1.35rem;
    margin: 0 0 0.35rem;
  }

  .project-body h2 a,
  .project-body h3 a,
  .tool-list h3 a {
    color: var(--glow-hot);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .project-tagline,
  .tool-list p {
    margin: 0;
    color: var(--glow);
  }

  .project-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.25rem;
    margin-top: 0.65rem;
    font-family: var(--mono);
    font-size: 0.72rem;
    line-height: 1.6;
    color: var(--white-45);
  }

  .project-section {
    margin-top: 4rem;
  }

  .project-section > h2 {
    margin-bottom: 0.5rem;
  }

  .project-section > p {
    color: var(--white-60);
    margin-bottom: 0;
  }

  .tool-list {
    gap: 2rem;
  }

  .tool-list li {
    margin: 0;
  }

  .project-footer {
    margin-top: 3.5rem;
    font-family: var(--mono);
    font-size: 0.75rem;
  }

  @media (max-width: 480px) {
    .project-entry {
      grid-template-columns: 48px minmax(0, 1fr);
      gap: 1rem;
    }

    .project-entry :global(.dither-thumb) {
      width: 48px;
      height: 48px;
    }
  }
</style>
