---
const year = new Date().getFullYear();
const links = [
  { href: 'mailto:alex@campos.works', label: 'Email' },
  { href: 'https://github.com/notaprompt', label: 'GitHub' },
  { href: '/writing', label: 'Writing' },
  { href: '/research/claims-capacity-collateral', label: 'Research' },
  { href: '/guestbook', label: 'Guestbook' },
];
---

<footer>
  <nav aria-label="Footer">
    <ul>
      {links.map(link => <li><a href={link.href}>{link.label}</a></li>)}
    </ul>
  </nav>
  <p>Alexander Campos, {year}. Virginia.</p>
</footer>

<style>
  footer { margin-top: 3rem; padding-top: 1rem; color: var(--white-60); font-size: 0.9rem; }
  ul { list-style: none; padding: 0; margin: 0 0 0.75rem; display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; }
  li { margin: 0; }
  a { color: var(--white-70); }
  p { margin: 0; }
</style>
